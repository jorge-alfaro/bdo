{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bdo-panel",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "bdo.alfaro.pw",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
