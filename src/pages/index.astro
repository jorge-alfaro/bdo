---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow, noarchive, noimageindex, nosnippet">
  <meta name="googlebot" content="noindex, nofollow, noarchive, noimageindex, nosnippet">
  <title>Black Desert · BDN</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preload" href="/fonts/cinzel-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/fonts.css">
</head>
<body>
<div class="wrap">

  <!-- HEADER · logbook title -->
  <div class="top">
    <div class="logo"><b>Black Desert</b><span>Bitácora del navegante</span></div>
  </div>

  <!-- NEXT BOSS · el retrato -->
  <div class="compass-card">
    <div class="heading" id="region">—</div>
    <div class="nb">
      <div class="portrait">
        <img id="nImg" src="/assets/garmoth.webp" alt="Próximo jefe">
      </div>
      <div class="slot">
        <div class="lbl">Next Boss</div>
        <div class="nm" id="nName"></div>
        <div class="cd" id="nCd">--:--:--</div>
        <div class="at" id="nAt"></div>
      </div>
      <div class="slot">
        <div class="lbl">Followed By</div>
        <div class="fby">
          <div class="fby-thumb"><img id="fImg" src="/assets/garmoth.webp" alt="Siguiente jefe"></div>
          <div class="fby-info">
            <div class="nm" id="fName"></div>
            <div class="cd f" id="fCd">--:--</div>
            <div class="at" id="fAt"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RELOJ · tira compacta de ancho completo -->
  <div class="plate clock">
    <div class="ck-date" id="date">--</div>
    <div class="ck-time" id="time">--:--:--</div>
    <div class="ck-reset"><small>Reset diario</small><b>6:00 PM</b></div>
    <div class="ck-reset"><small>Reset semanal</small><b>Mié · 6:00 PM</b></div>
    <div class="ck-count"><span id="weeklyTimer">—</span></div>
  </div>

  <!-- NOTAS · un solo desplegable con Semanal + Notas -->
  <div class="paper col-card" id="card-notas">
    <button class="col-bar" data-card="notas" aria-expanded="true">
      <span class="col-title">Notas</span>
      <span class="col-caret" aria-hidden="true"></span>
    </button>
    <div class="col-body">
      <div class="notes-grid">
        <div class="notes-block">
          <div class="nb-head">
            <h3>Semanal</h3>
            <button class="addbtn" data-modal="weekly" title="Agregar tarea semanal" aria-label="Agregar tarea semanal">+</button>
          </div>
          <div id="weeklies"></div>
        </div>
        <div class="notes-block">
          <div class="nb-head">
            <h3>Rápidas</h3>
            <button class="addbtn" data-modal="todo" title="Agregar nota" aria-label="Agregar nota">+</button>
          </div>
          <div id="todos"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- JEFES MUNDIALES -->
  <div class="paper">
    <h2>Jefes Mundiales</h2>
    <div class="sub">Recompensas limitadas por semana · toca para marcar</div>
    <div class="bosses" id="bosses"></div>
    <div style="text-align:right;margin-top:10px"><button class="rst" id="rstB">Reiniciar semana</button></div>

    <h2 style="margin-top:20px">Horarios de tu región</h2>
    <div class="sc"><table>
      <thead><tr><th>Hora</th><th>Jefe</th><th>Días</th><th></th></tr></thead>
      <tbody id="sched"></tbody>
    </table></div>
  </div>
</div>

<!-- MODAL · agregar notas -->
<div class="modal-overlay" id="modal" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <h3 id="modalTitle">Nueva nota</h3>
    <div id="modalWeekly" class="modal-fields" hidden>
      <input id="wi" placeholder="Título...">
      <input id="wid" placeholder="Descripción...">
    </div>
    <div id="modalTodo" class="modal-fields" hidden>
      <input id="ti" placeholder="Agregar nota...">
    </div>
    <div class="modal-actions">
      <button class="btn-ghost" id="modalCancel">Cancelar</button>
      <button class="btn-primary" id="modalSave">Agregar</button>
    </div>
  </div>
</div>

<!-- MODAL · confirmar reinicio semanal -->
<div class="modal-overlay" id="confirm" hidden>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
    <h3 id="confirmTitle">¿Reiniciar la semana?</h3>
    <p class="msg">Se reiniciarán los contadores de jefes y se desmarcarán las tareas de <b>Semanal</b>. Las notas de <b>Rápidas</b> no se tocan.</p>
    <div class="modal-actions">
      <button class="btn-ghost" id="confirmCancel">Cancelar</button>
      <button class="btn-primary" id="confirmOk">Reiniciar</button>
    </div>
  </div>
</div>

<script>
// ===== EDITA AQUÍ tus horarios (hora local, d = días 0=Dom..6=Sáb) =====
const SCHEDULE=[
 {t:"00:15",boss:"Karanda",img:"/assets/karanda.webp",region:"Olvia",d:[3],txt:"Miércoles",tag:"Semanal"},
 {t:"12:00",boss:"Karanda",img:"/assets/karanda.webp",region:"Olvia",d:[5],txt:"Viernes",tag:"Semanal"},
 {t:"14:00",boss:"Garmoth",img:"/assets/garmoth.webp",region:"Duvencrune",d:[0,1,2,3,4,5,6],txt:"Todos los días",tag:"Diario"},
 {t:"16:00",boss:"Vell",img:"/assets/vell.webp",region:"Ojo de Oquilla",d:[0],txt:"Domingo",tag:"Semanal"},
 {t:"16:00",boss:"Quint",img:"/assets/quint.webp",region:"Calpheon",d:[4],txt:"Jueves",tag:"Semanal"},
 {t:"18:00",boss:"Rawr-Rawr",img:"/assets/rawr-rawr.webp",region:"O'dyllita",d:[0,1,2,3,4,5,6],txt:"Todos los días",tag:"Diario"},
 {t:"19:00",boss:"Garmoth",img:"/assets/garmoth.webp",region:"Duvencrune",d:[0],txt:"Domingo",tag:"Semanal"},
 {t:"19:00",boss:"Vell",img:"/assets/vell.webp",region:"Ojo de Oquilla",d:[3],txt:"Miércoles",tag:"Semanal"},
 {t:"19:00",boss:"Karanda",img:"/assets/karanda.webp",region:"Olvia",d:[1],txt:"Lunes",tag:"Semanal"},
 {t:"19:00",boss:"Quint",img:"/assets/quint.webp",region:"Calpheon",d:[6],txt:"Sábado",tag:"Semanal"},
 {t:"22:15",boss:"Karanda",img:"/assets/karanda.webp",region:"Olvia",d:[3],txt:"Miércoles",tag:"Semanal"},
 {t:"23:15",boss:"Garmoth",img:"/assets/garmoth.webp",region:"Duvencrune",d:[0,1,2,3,4,5],txt:"Todos excepto sábado",tag:"Diario"}
];
const BOSSES=[{n:"Garmoth",img:"/assets/garmoth.webp",max:3,r:"Escamas de Garmoth"},{n:"Rawr-Rawr",img:"/assets/rawr-rawr.webp",max:1,r:"Botín semanal"},{n:"Vell",img:"/assets/vell.webp",max:1,r:"Corazón de Vell"},{n:"Quint",img:"/assets/quint.webp",max:2,r:"Estatua de Quint · Piedra Iridiscente"},{n:"Karanda",img:"/assets/karanda.webp",max:1,r:"Auras latentes (100) → Cofre Dienteleón"}];
// ======================================================================
const $=id=>document.getElementById(id);
const pad=n=>String(n).padStart(2,"0");
const store={get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};

function occ(){ // próximas ocurrencias
  const now=new Date(),out=[];
  for(let i=0;i<9;i++){
    const day=new Date(now.getFullYear(),now.getMonth(),now.getDate()+i);
    SCHEDULE.forEach(s=>{
      if(!s.d.includes(day.getDay()))return;
      const [h,m]=s.t.split(":").map(Number);
      const at=new Date(day.getFullYear(),day.getMonth(),day.getDate(),h,m,0);
      if(at>now)out.push({at,s});
    });
  }
  return out.sort((a,b)=>a.at-b.at);
}
function group(list,start){ // agrupa jefes a la misma hora
  const first=list[start];if(!first)return null;
  const g=list.filter(o=>+o.at===+first.at);
  return {at:first.at,items:g,end:start+g.length};
}
const fmt=ms=>{const s=Math.max(0,Math.floor(ms/1000));return pad(Math.floor(s/3600))+":"+pad(Math.floor(s%3600/60))+":"+pad(s%60)};
const fmtShort=ms=>{const s=Math.max(0,Math.floor(ms/1000));const h=Math.floor(s/3600),m=Math.floor(s%3600/60);return `${h}h ${pad(m)}m`};
const hm=d=>pad(d.getHours())+":"+pad(d.getMinutes());
function weeklyTimer(){ // cuenta regresiva al reset semanal (Mié 6:00 PM)
  const now=new Date();
  const day=now.getDay(); // 3 = Miércoles
  let daysUntil=(3-day+7)%7;
  let reset=new Date(now.getFullYear(),now.getMonth(),now.getDate()+daysUntil,18,0,0);
  if(daysUntil===0 && now>=reset){ // ya pasó el reset de hoy -> próximo miércoles
    reset=new Date(now.getFullYear(),now.getMonth(),now.getDate()+7,18,0,0);
    daysUntil=7;
  }
  const ms=reset-now;
  const totalHours=Math.floor(ms/3600000);
  const d=Math.floor(totalHours/24);
  const h=totalHours%24;
  return daysUntil===0 ? `[HOY] ${h}hrs` : `${d}D ${h}hrs`;
}
function paint(g,slotName,slotCd,slotAt,next){
  if(!g)return;
  $(slotName).textContent=g.items.map(o=>o.s.boss).join(" | ");
  $(slotAt).textContent="a las "+hm(g.at);
  if(next){$("nImg").src=g.items[0].s.img;$("region").textContent=[...new Set(g.items.map(o=>o.s.region))].join(" · ");}
  else{$("fImg").src=g.items[0].s.img;}
}
let curKey="";
function tick(){
  const now=new Date();
  $("time").textContent=pad(now.getHours())+":"+pad(now.getMinutes())+":"+pad(now.getSeconds());
  let d=now.toLocaleDateString("es-MX",{weekday:"short"});
  $("date").textContent=d.replace(/\./g,"").toUpperCase();
  $("weeklyTimer").textContent=weeklyTimer();
  const l=occ(),g1=group(l,0),g2=g1?group(l,g1.end):null;
  if(g1){$("nCd").textContent=fmt(g1.at-now);const k=+g1.at+"|"+(g2?+g2.at:0);if(k!==curKey){curKey=k;paint(g1,"nName","nCd","nAt",true);paint(g2,"fName","fCd","fAt",false);renderSched(g1.at)}}
  if(g2)$("fCd").textContent=fmtShort(g2.at-now);
}
function renderSched(nextAt){
  $("sched").innerHTML=SCHEDULE.map(s=>{
    const nx=nextAt&&hm(nextAt)===s.t&&s.d.includes(nextAt.getDay());
    return `<tr class="${nx?"nx":""}"><td>${s.t}</td><td><img class="mini" src="${s.img}" alt="${s.boss}"> ${s.boss}</td><td>${s.txt}</td><td><span class="tag ${s.tag==="Diario"?"d":"s"}">${s.tag}</span></td></tr>`}).join("");
}
// Contadores de jefes
let cnt=store.get("bdo_cnt",{});if(cnt.Laulau!==undefined&&cnt["Rawr-Rawr"]===undefined){cnt["Rawr-Rawr"]=cnt.Laulau;delete cnt.Laulau;store.set("bdo_cnt",cnt);}
function renderB(){
  $("bosses").innerHTML=BOSSES.map(b=>{const c=cnt[b.n]||0,done=c>=b.max;
    return `<div class="b ${done?"done":""}" data-n="${b.n}"><div class="em"><img src="${b.img}" alt="${b.n}"></div><b>${b.n}</b><div class="c">${done?"✔ ":"○ "}${c} / ${b.max}</div><small>${b.r}</small>${done?'<span class="stamp">Hecho</span>':""}</div>`}).join("");
  document.querySelectorAll(".b").forEach(e=>e.onclick=()=>{const b=BOSSES.find(x=>x.n===e.dataset.n);cnt[b.n]=(cnt[b.n]||0)>=b.max?0:(cnt[b.n]||0)+1;store.set("bdo_cnt",cnt);renderB()});
}
function resetWeek(){cnt={};store.set("bdo_cnt",cnt);renderB();weeklies=weeklies.map(w=>({...w,done:false}));store.set("bdo_weekly",weeklies);renderW()}
$("rstB").onclick=()=>{$("confirm").hidden=false;$("confirmOk").focus()};
$("confirmOk").onclick=()=>{resetWeek();$("confirm").hidden=true};
$("confirmCancel").onclick=()=>{$("confirm").hidden=true};
$("confirm").addEventListener("click",e=>{if(e.target===$("confirm"))$("confirm").hidden=true});
// Semanal (checklist) — las tareas persisten, solo se desmarca el check al resetear
let weeklies=(store.get("bdo_weekly",[])||[]).map(w=>typeof w==="string"?{t:w,done:false,desc:""}:{t:w.t,done:!!w.done,desc:w.desc||""});
function renderW(){
  $("weeklies").innerHTML=weeklies.map((w,i)=>`<div class="wi"><label class="chk"><input type="checkbox" data-i="${i}" ${w.done?"checked":""}><div><b></b><small></small></div></label><button class="btnx" data-i="${i}">✕</button></div>`).join("");
  document.querySelectorAll("#weeklies .wi").forEach((el,i)=>{
    el.querySelector("b").textContent=weeklies[i].t;
    el.querySelector("small").textContent=weeklies[i].desc;
    el.querySelector("input").onchange=e=>{weeklies[i].done=e.target.checked;store.set("bdo_weekly",weeklies)};
    el.querySelector("button").onclick=()=>{weeklies.splice(i,1);store.set("bdo_weekly",weeklies);renderW()};
  });
}
function addW(){
  const t=$("wi").value.trim();if(!t)return false;
  const d=$("wid").value.trim();
  weeklies.push({t,done:false,desc:d});
  store.set("bdo_weekly",weeklies);renderW();
  return true;
}
// Pendientes
let todos=store.get("bdo_todos",[]);
function renderT(){
  $("todos").innerHTML=todos.map((t,i)=>`<div class="pi"><span></span><button class="btnx" data-i="${i}">✕</button></div>`).join("");
  document.querySelectorAll("#todos .pi").forEach((el,i)=>{el.firstChild.textContent=todos[i];el.lastChild.onclick=()=>{todos.splice(i,1);store.set("bdo_todos",todos);renderT()}});
}
function addT(){const v=$("ti").value.trim();if(!v)return false;todos.push(v);store.set("bdo_todos",todos);renderT();return true}

// --- Modal para agregar notas ---
let modalMode=null;
function openModal(mode){
  modalMode=mode;
  $("modalTitle").textContent = mode==="weekly" ? "Nueva tarea semanal" : "Nueva nota";
  $("modalWeekly").hidden = mode!=="weekly";
  $("modalTodo").hidden = mode!=="todo";
  $("modal").hidden=false;
  (mode==="weekly"?$("wi"):$("ti")).focus();
}
function closeModal(){
  $("modal").hidden=true;
  $("wi").value="";$("wid").value="";$("ti").value="";
  modalMode=null;
}
function saveModal(){
  if(modalMode==="weekly"){ if(addW()) closeModal(); }
  else if(modalMode==="todo"){ if(addT()) closeModal(); }
}
$("modalSave").onclick=saveModal;
$("modalCancel").onclick=closeModal;
$("modal").addEventListener("click",e=>{ if(e.target===$("modal")) closeModal(); });
document.addEventListener("keydown",e=>{ if(e.key!=="Escape")return; if(!$("modal").hidden) closeModal(); if(!$("confirm").hidden) $("confirm").hidden=true; });
["wi","wid","ti"].forEach(id=>$(id).addEventListener("keydown",e=>{ if(e.key==="Enter") saveModal(); }));
document.querySelectorAll(".addbtn").forEach(b=>b.onclick=()=>openModal(b.dataset.modal));

// --- Secciones desplegables (estado en localStorage) ---
let ui=Object.assign({notas:false},store.get("bdo_ui",{}));
function applyCollapse(card,open){const el=document.getElementById("card-"+card);if(!el)return;el.classList.toggle("collapsed",!open);const bar=el.querySelector(".col-bar");if(bar)bar.setAttribute("aria-expanded",open?"true":"false");}
function toggleCard(card){ui[card]=!ui[card];store.set("bdo_ui",ui);applyCollapse(card,ui[card]);}
document.querySelectorAll(".col-bar").forEach(b=>b.onclick=()=>toggleCard(b.dataset.card));
applyCollapse("notas",ui.notas);

renderB();renderT();renderW();renderSched();tick();setInterval(tick,1000);
</script>
</body>
</html>
